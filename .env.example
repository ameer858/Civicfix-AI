# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT="3000"

# BOOTSTRAP_ADMIN_EMAIL: Server-side allowlisted email(s) eligible for initial Admin bootstrap
BOOTSTRAP_ADMIN_EMAIL="anshadameer61@gmail.com"

# Supabase PostgreSQL & Authentication
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_SECRET_KEY="" # Server-only; never expose to client
# VITE_SUPABASE_URL="https://your-project.supabase.co"
# VITE_SUPABASE_PUBLISHABLE_KEY=""

# Department Authority Email Transport (Configure real SMTP credentials OR Resend API key)
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM=""
# RESEND_API_KEY=""

# Cloudinary Signed Server-Side Image Storage (Server-only; never expose secrets to client)
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

